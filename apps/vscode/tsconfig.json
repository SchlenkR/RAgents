{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vscode"
    ],
    "paths": {
      "@aicontainer/server/*": [
        "../../apps/server/src/*"
      ],
      "@aicontainer/web/*": [
        "../../apps/web/src/*"
      ],
      "@aicontainer/plugins/*": [
        "../../plugins/*"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
