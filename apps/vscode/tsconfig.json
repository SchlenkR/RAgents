{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2024",
      "DOM"
    ],
    "types": [
      "node",
      "vscode"
    ],
    "paths": {
      "@ragents/host/*": [
        "../../apps/server/src/*"
      ],
      "@ragents/web/*": [
        "../../apps/web/src/*"
      ],
      "@ragents/plugins/*": [
        "../../plugins/*"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
