{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "lib": [
      "ES2024"
    ],
    "paths": {
      "@ragents/host/*": [
        "../../apps/server/src/*"
      ],
      "@ragents/web/*": [
        "../../apps/web/src/*"
      ],
      "@ragents/plugins/*": [
        "../../plugins/*"
      ],
      "@ragents/workflow": [
        "../../apps/server/src/plugin-support/actor-programs/workflow/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../plugins/*/server",
    "../../plugins/*/contract.ts",
    "../../ragents.config.*.ts"
  ]
}
