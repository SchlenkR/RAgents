{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../apps/server/node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      "@aicontainer/server/*": [
        "../../apps/server/src/*"
      ],
      "@aicontainer/web/*": [
        "../../apps/web/src/*"
      ],
      "@aicontainer/plugins/*": [
        "../../plugins/*"
      ],
      "@ragents/client/ui": [
        "../../plugins/ragents.actor-programs/client-ui/index.tsx"
      ],
      "@ragents/workflow": [
        "../../plugins/ragents.actor-programs/workflow/index.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "generate-homepage.ts",
    "homepage-*.ts",
    "../../docs/homepage/reference-ui.tsx",
    "../../docs/homepage/*-preview.tsx"
  ]
}
