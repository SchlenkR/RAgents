{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Agentenlaufzeit, Web und Homepage bauen.",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/build/build.sh"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "open: homepage",
      "detail": "Homepage bauen und anschließend im Standardbrowser öffnen.",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/build/homepage.sh",
        "--open"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "check",
      "detail": "Projekt vollständig prüfen: Tests, Typen, Lint, Web und Homepage.",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/build/check.sh"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "vscode: build",
      "detail": "VS-Code-Erweiterung unter apps/vscode bündeln.",
      "type": "process",
      "command": "pnpm",
      "args": [
        "--filter",
        "ragents-vscode",
        "build"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "vscode: start (core)",
      "detail": "VS-Code-Testinstanz mit der RAgents-Erweiterung gegen den core-Server starten.",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/start-vscode.sh",
        "core"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
