{
	"name": "@ragents/ai",
	"version": "0.80.10",
	"description": "The LLM access of RAgents: the OpenRouter provider over AI SDK Core, its model catalog and streaming",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./src/api-registry.ts"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./src/index.ts"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./src/providers/*.ts"
		},
		"./api/*": {
			"types": "./dist/api/*.d.ts",
			"import": "./src/api/*.ts"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"ai": "^7.0.99",
		"partial-json": "0.1.7",
		"typebox": "1.1.38"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3"
	}
}
