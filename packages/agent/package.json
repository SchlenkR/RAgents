{
	"name": "@ragents/agent",
	"version": "0.80.10",
	"description": "The agent runtime of RAgents: agent loop, sessions, compaction, extension hooks and the read, write, edit and bash tools",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@ragents/ai": "^0.80.10",
		"@silvia-odwyer/photon-node": "0.3.4",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"typebox": "1.1.38",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/diff": "7.0.2",
		"@types/node": "24.12.4",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
