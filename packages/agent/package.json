{
	"name": "@aicontainer/agent",
	"version": "0.80.10",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@aicontainer/agent-core": "^0.80.10",
		"@aicontainer/ai": "^0.80.10",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"glob": "13.0.6",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"minimatch": "10.2.5",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.0",
		"typebox": "1.1.38",
		"undici": "8.5.0",
		"yaml": "2.9.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/diff": "7.0.2",
		"@types/hosted-git-info": "3.0.5",
		"@types/ms": "2.1.0",
		"@types/node": "24.12.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"shx": "0.4.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"appConfig": {
		"name": "agent",
		"configDir": ".agent"
	},
	"agentConfig": {
		"name": "agent",
		"configDir": ".agent"
	}
}
