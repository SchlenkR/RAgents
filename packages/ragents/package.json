  },
  "dependencies": {
    "@ragents/agent": "workspace:*",
    "@ragents/ai": "workspace:*",
    "@types/node": "^24.10.0",
    "typebox": "1.1.38",
    "typescript": "^5.9.0",
    "yaml": "^2.9.0"
  }
}
