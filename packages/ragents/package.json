{
  "name": "@ragents/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*.ts": "./src/*.ts",
    "./src/*": "./src/*.ts",
    "./tests/*": "./tests/*"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
